{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "中亚合作项目承诺协调",
  "type": "object",
  "required": [
    "domain",
    "version",
    "actors",
    "facts",
    "constraints"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "const": "central-asia-project-commitment"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
